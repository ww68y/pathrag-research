# Copy this file to .env and replace every placeholder with a private value.
# Do not commit .env or real API credentials.

SECRET_KEY=replace_with_a_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Default model configuration (OpenAI-compatible provider)
DEEPSEEK_API_KEY=your_provider_api_key
DEEPSEEK_API_BASE=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_DIM=1024
EMBEDDING_MAX_TOKENS=8192

# Local application data
DATABASE_URL=sqlite:///./pathrag.db
WORKING_DIR=./data
UPLOAD_DIR=./uploads

# Development server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# Optional ingestion and concurrency settings
CHUNK_SIZE=1200
CHUNK_OVERLAP=100
ENTITY_EXTRACT_MAX_GLEANING=0
EMBEDDING_ASYNC=1
LLM_ASYNC=1
